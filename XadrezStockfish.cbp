    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="Xadrez 3D" />
        <Option compiler="gcc" />
        <Build>
            <Target title="Windows">
                <Option output="bin/Windows/xadrez" prefix_auto="0" extension_auto="1" />
                <Option object_output="obj/Windows" />
                <Option type="1" />
                <Option working_dir="." />
                <MakeCommands>
                    <Build command="python tools/build.py --output bin/Windows" />
                    <CompileFile command="python tools/build.py --output bin/Windows" />
                    <SilentBuild command="python tools/build.py --output bin/Windows" />
                </MakeCommands>
            </Target>
            <Target title="Linux">
                <Option output="bin/Linux/xadrez" prefix_auto="0" extension_auto="1" />
                <Option object_output="obj/Linux" />
                <Option type="1" />
                <Option working_dir="." />
                <MakeCommands>
                    <Build command="python3 tools/build.py --output bin/Linux" />
                    <CompileFile command="python3 tools/build.py --output bin/Linux" />
                    <SilentBuild command="python3 tools/build.py --output bin/Linux" />
                </MakeCommands>
            </Target>
            <Target title="macOS">
                <Option output="bin/macOS/xadrez" prefix_auto="0" extension_auto="1" />
                <Option object_output="obj/macOS" />
                <Option type="1" />
                <Option working_dir="." />
                <MakeCommands>
                    <Build command="python3 tools/build.py --output bin/macOS" />
                    <CompileFile command="python3 tools/build.py --output bin/macOS" />
                    <SilentBuild command="python3 tools/build.py --output bin/macOS" />
                </MakeCommands>
            </Target>
        </Build>
