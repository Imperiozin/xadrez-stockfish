<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="Xadrez Stockfish - Terminal" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />
        <Build>
            <Target title="Windows">
                <Option output="bin/Windows/xadrez.exe" prefix_auto="0" extension_auto="0" />
                <Option working_dir="." />
                <Option object_output="obj/Windows/" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Linker><Add option="-static" /></Linker>
                <ExtraCommands>
                    <Add before="cmd /c preparar.bat bin/Windows" />
                </ExtraCommands>
            </Target>
            <Target title="Linux">
                <Option output="bin/Linux/xadrez" prefix_auto="0" extension_auto="0" />
                <Option working_dir="." />
                <Option object_output="obj/Linux/" />
                <Option type="1" />
                <Option compiler="gcc" />
                <ExtraCommands>
                    <Add before="python3 tools/setup_engine.py --output bin/Linux" />
                </ExtraCommands>
            </Target>
            <Target title="macOS">
                <Option output="bin/macOS/xadrez" prefix_auto="0" extension_auto="0" />
                <Option working_dir="." />
                <Option object_output="obj/macOS/" />
                <Option type="1" />
                <Option compiler="gcc" />
                <ExtraCommands>
                    <Add before="python3 tools/setup_engine.py --output bin/macOS" />
                </ExtraCommands>
            </Target>
        </Build>
        <Compiler>
            <Add option="-std=c++17" />
            <Add option="-O2" />
            <Add option="-Wall" />
            <Add option="-Wextra" />
            <Add option="-pthread" />
            <Add directory="src" />
            <Add directory="vendor/chess-library" />
        </Compiler>
        <Linker>
            <Add option="-pthread" />
        </Linker>
        <Unit filename="src/main.cpp"><Option compilerVar="CPP" /></Unit>
        <Unit filename="src/jogo.cpp"><Option compilerVar="CPP" /></Unit>
        <Unit filename="src/jogo.hpp" />
        <Unit filename="src/stockfish.cpp"><Option compilerVar="CPP" /></Unit>
        <Unit filename="src/stockfish.hpp" />
        <Unit filename="src/arquivos.hpp" />
        <Unit filename="src/autoteste.cpp"><Option compilerVar="CPP" /></Unit>
        <Unit filename="src/autoteste.hpp" />
        <Unit filename="README.md" />
        <Extensions />
    </Project>
</CodeBlocks_project_file>
